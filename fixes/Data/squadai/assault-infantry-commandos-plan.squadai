
-- command macros
import("squadai-util")

-- squadai plan file

--------------------------------------------------------------------------------
-- tuning

-- global to all phases
cover_search_radius	= 12
cover_search_angle	= 75
formation			= "squad_formations/squad_ai.lua"
MAXCASTERS = 1

--------------------------------------------------------------------------------
-- sound options

sound =
{
	soundDirectory	= "Battle_Chatter",
	soundPercentage	= 30.0,
}

--------------------------------------------------------------------------------
-- plan

plan = 
{
	-- phase1 - Engagement
	{
		type = DATA_PHASE,
		name = "Engagement",	
		
		--
		{
			apply_to = ET_All,
			actions =
			{
				-- toggle modifiers on
				ACTION_DO_CRITICAL( "critical\\assault_modifiers.lua", "assault modifiers" ),
			},
		},
		
		--
		{
			apply_to = ET_All,
			actions =
			{
				-- set pour on fire formation
				ACTION_MOVE_POSTURE( DT_MAX_SQUAD_RANGE, 0.6, cover_search_radius, cover_search_angle, formation, PACE_FAST, PACE_MEDIUM, POSTURE_CROUCH, POSTURE_PRONE, 0.0 ),
				ACTION_DO_ABILITY( "abilities\\ally_throw_grenade_assault.lua", MAXCASTERS ),
			},
		},
	},
	
	-- phase3 - Charge
	PHASE_LEAP_FROG_ABILITY( "Leap Frog", DT_MAX_SQUAD_RANGE, 0.4, 0.45, 4.0, 45.0, formation, PACE_MEDIUM, POSTURE_PRONE, 1.0, "abilities\\axis_throw_grenade_assault.lua", {ET_RFlank, ET_LFlank}, 1, 1 ),
	
	-- phase4 - Final Attack
	{
		type = DATA_PHASE,
		name = "Final Attack",
		
		{
			apply_to = {ET_Core},
			actions = 
			{
				-- run up closer
				ACTION_MOVE_POSTURE( DT_MAX_SQUAD_RANGE, 0.60, cover_search_radius, cover_search_angle, formation, PACE_FAST, PACE_FAST, POSTURE_CROUCH, POSTURE_PRONE, 1.0 ),
				
				-- throw some grenades
				ACTION_DO_ABILITY( "abilities\\ally_throw_grenade_assault.lua", 1 ),
				-- run back
				ACTION_MOVE_POSTURE_EXT( DT_MAX_SQUAD_RANGE, 0.4, cover_search_radius, cover_search_angle, formation, PACE_VERYFAST, PACE_FAST, POSTURE_CROUCH, POSTURE_PRONE, 0.0, true, false, false ),
			},
		},
	},

	-- phase2 - Remove Modifiers
	{
		type = DATA_PHASE,
		name = "Remove Modifiers",
		
		-- 
		{
			apply_to = ET_All,
			actions = 
			{
				-- toggle modifiers off
				ACTION_UNDO_ALL_CRITICALS(),
			},
		},
	},
}
